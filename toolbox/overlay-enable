#!/bin/bash
# enable (or disable) the read-only overlay root on-device. building the
# initramfs is kernel-version specific, so this cannot be done by editing files
# offline -- it must run on the booted device (invoked by overlay-firstboot).
# the premount logic itself ships in rootfs/etc/initramfs-tools/scripts/overlay.
#
# usage: overlay-enable [tmpfs|persist|off]   (default: tmpfs)

set -euo pipefail

MODE="${1:-tmpfs}"
FW=/boot/firmware
KERN="$(uname -r)"
INITRD="initrd.img-$KERN-overlay"
MODULES=/etc/initramfs-tools/modules

case "$MODE" in tmpfs|persist|off) ;; *) echo "usage: overlay-enable [tmpfs|persist|off]" >&2; exit 1 ;; esac

strip_cmdline() { sed -i -e 's/\bboot=overlay *//g' -e 's/ *overlay-upper=[^ ]*//g' "$FW/cmdline.txt"; }

if [ "$MODE" = off ]; then
	sed -i '/^initramfs .*-overlay$/d' "$FW/config.txt"
	strip_cmdline
	rm -f "$FW/$INITRD"
	echo "overlay root disabled (reboot to apply)"
	exit 0
fi

grep -qx overlay "$MODULES" || echo overlay >> "$MODULES"

rm -f "/boot/initrd.img-$KERN"
update-initramfs -c -k "$KERN"
cp "/boot/initrd.img-$KERN" "$FW/$INITRD"

# a single explicit initramfs directive on the firmware partition.
sed -i '/^initramfs /d' "$FW/config.txt"
echo "initramfs $INITRD" >> "$FW/config.txt"

# turn on overlay root and select the upper-layer shape on the kernel cmdline.
strip_cmdline
sed -i -e 's/^/boot=overlay /' -e "s/\$/ overlay-upper=$MODE/" "$FW/cmdline.txt"
echo "overlay root enabled (upper=$MODE); reboot to apply"
