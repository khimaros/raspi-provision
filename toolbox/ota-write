#!/bin/bash
# replace the image on the card this device booted from with the gzip image on
# stdin, then restart into it. `raspi-provision ota` copies this and
# toolbox/write-image to the device's /run and pipes it the image over ssh, so a
# device flashed before either existed takes them too. the arguments after the
# writer's path are write-image's own: `wipe` replaces the whole card as `flash
# --wipe` does, and `keep SECTORS` leaves the persist partition as it is.
#
# the card is overwritten under a running system, so that system has to go on
# without it. everything on the card is made read-only first, so nothing the old
# system still holds is written over the new image, and a persist partition that
# is kept is left whole. every file a running program has mapped is read once
# more, since a page the kernel fetches later would come from the new image.
# that is a habit of the page cache and no promise: with memory to spare nothing
# is dropped, and the pipe below needs little.
#
# a stream that ends early or does not decompress leaves the card half written
# and this system still up, in memory, to be sent the image again. once it loses
# power in that state the card needs a reader.
#
# run as root. usage: ota-write WRITE-IMAGE wipe|keep [SECTORS] < image.gz

set -euo pipefail

BOOT_LABEL=bootfs
# what this script and write-image still start after the first block is written
TOOLS=(gzip dd head cat sleep)
# seconds for the kernel to make the card's filesystems read-only
REMOUNT_TIMEOUT=30
# seconds between reporting success and the restart, for ssh to pass it on
RESTART_DELAY=2

die() { echo "ota: $*" >&2; exit 1; }

# hold every file a running program has mapped, and the tools, in the page
# cache. files only: a program that draws has the gpu's device mapped, and
# reading a device may never come to an end
keep_in_memory() {
	{ awk '$6 ~ "^/" { print $6 }' /proc/[0-9]*/maps 2>/dev/null; command -v "${TOOLS[@]}"; } | sort -u \
		| while IFS= read -r mapped; do [ ! -f "$mapped" ] || cat "$mapped" 2>/dev/null || true; done >/dev/null
}

# true while a filesystem on a block device still takes writes
writable() {
	awk '$1 ~ "^/dev/" && $4 ~ /^rw(,|$)/ { found = 1 } END { exit !found }' /proc/mounts
}

# the kernel's emergency remount: unlike `mount -o remount,ro` it does not
# refuse a filesystem with files open for writing, as the overlay upper has
make_read_only() {
	sync
	echo u > /proc/sysrq-trigger
	for ((i = 0; i < REMOUNT_TIMEOUT; i++)); do
		writable || return 0
		sleep 1
	done
	return 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ -t 0 ] && die "no image on stdin"
[ $# -ge 2 ] || die "usage: ota-write WRITE-IMAGE wipe|keep [SECTORS] < image.gz"
write_image=$1
shift
[ -r "$write_image" ] || die "no writer at $write_image"
boot="$(blkid -L "$BOOT_LABEL" 2>/dev/null)" || die "no '$BOOT_LABEL' partition to find the card by"
card="/dev/$(lsblk -no pkname "$boot")"
[ -b "$card" ] || die "$card is not a block device"

keep_in_memory
make_read_only || die "filesystems still writable after ${REMOUNT_TIMEOUT}s; nothing written. restart to go on as before"

echo "ota: writing $card"
if ! gzip -dc | bash "$write_image" "$card" "$@"; then
	die "FAILED part way: the card holds neither image whole. this system still runs from memory, so send the image again before it loses power"
fi

echo "ota: written, restarting"
# the kernel's own restart: `reboot` would be read from the card just replaced
( trap '' HUP; sleep "$RESTART_DELAY"; echo b > /proc/sysrq-trigger ) </dev/null >/dev/null 2>&1 &
