#!/bin/bash
# carve an ext4 'persist' partition from the tail of a flashed sdcard (or raw
# image attached via 'losetup -P'). raspberry pi os expands the root partition
# to fill the whole card on first boot (the ' resize' cmdline token, handled by
# the stock initramfs resize_early script); we strip that token and instead grow
# root to leave room for a dedicated persist partition. persist survives a
# factory reset and, under the read-only overlay root, holds the state that must
# survive reboots.
#
# run on the unmounted device after 'make flash' and before first boot. needs
# root (parted/mkfs/mount); the Makefile invokes it via sudo. idempotent.

set -euo pipefail

DEV="${1:?usage: partition-persist <device> [persist-size-mib]}"
PERSIST_MIB="${2:-1024}"
PERSIST_LABEL=persist
RESIZE_TOKEN=" resize"

# partition node N of DEV (mmcblk0/loopN take a 'p' separator, sdX does not).
part() { case "$DEV" in *[0-9]) echo "${DEV}p$1" ;; *) echo "${DEV}$1" ;; esac; }

for t in parted partprobe mkfs.ext4 e2fsck resize2fs blkid; do
	command -v "$t" >/dev/null || { echo "missing required tool: $t" >&2; exit 1; }
done

boot="$(part 1)"; root="$(part 2)"; persist="$(part 3)"

if [ -b "$persist" ] && [ "$(blkid -o value -s LABEL "$persist" 2>/dev/null)" = "$PERSIST_LABEL" ]; then
	echo "persist partition already present, skipping"
	exit 0
fi

echo "stripping raspios first-boot resize token from cmdline.txt"
mnt="$(mktemp -d)"
mount "$boot" "$mnt"
sed -i "s|${RESIZE_TOKEN}||g" "$mnt/cmdline.txt"
umount "$mnt"; rmdir "$mnt"

# grow root to fill everything except the persist tail, then add persist.
disk_end_mib=$(( $(blockdev --getsize64 "$DEV") / 1024 / 1024 ))
root_end_mib=$(( disk_end_mib - PERSIST_MIB ))
echo "growing root ($root) to ${root_end_mib}MiB, persist (${persist}) ${PERSIST_MIB}MiB"

e2fsck -fy "$root" || true
parted -s "$DEV" unit MiB resizepart 2 "$root_end_mib"
partprobe "$DEV"; sleep 1
resize2fs "$root"
parted -s "$DEV" unit MiB mkpart primary ext4 "$root_end_mib" 100%
partprobe "$DEV"; sleep 1
mkfs.ext4 -F -L "$PERSIST_LABEL" "$persist"
sync
echo "persist partition created"
