#!/bin/sh
# read-only root via overlayfs. selected by 'boot=overlay' on the kernel
# cmdline, which makes initramfs-tools source this script instead of
# /scripts/local. the real root is mounted read-only as the lower layer so an
# unclean power loss cannot corrupt it; a writable upper layer is stacked over
# it. enable/disable with toolbox/overlay-enable.
#
# upper-layer shape, chosen by the 'overlay-upper=' cmdline token:
#   tmpfs   (default) -- volatile RAM upper; every boot is a clean slate. identity
#                        (ssh keys, machine-id, NM connections, /home) is bind-
#                        mounted from the persist partition (see PERSIST_BINDS), and
#                        other changes can be made durable on demand with
#                        toolbox/overlay-commit -- committed changes live on persist
#                        as the upper of an inner overlay over the base (so
#                        deletions persist too), with the tmpfs upper stacked above.
#   persist           -- the persist partition itself; all changes survive.
#
# this script also performs the factory reset (see factory_reset) before the
# upper is assembled, so the reset happens while nothing is live yet.
#
# the FAT boot partition is not live under an overlay root: the root carries its
# own boot/firmware (a build-time copy of FAT, bind-mounted so the kernel hooks
# see a mountpoint) and the FAT is at /boot/bootfs. kernel and firmware updates
# land in the writable layer like any other change; firmware_sync copies them to
# FAT here, once they are durable (committed, or on the persist upper), and
# reboots into them. a reset or an uncommitted reboot thus never leaves FAT
# holding a kernel whose modules are gone.

# reuse initramfs-tools' local script; we override only the root-mount step.
. /scripts/local

# filesystem labels written by toolbox/partition-persist and the raspios image.
PERSIST_LABEL=persist
BOOT_LABEL=bootfs
# flag file on the FAT boot partition that requests a factory reset.
RESET_FLAG=factory-reset
# layout on the persist partition. keep in sync with toolbox/seed-persist.
PERSIST_STATE=state
PERSIST_FACTORY=factory/state.tar
PERSIST_DATA=data
PERSIST_WORK=work
# paths bind-mounted from the persist partition in the ephemeral shape. keep in
# sync with toolbox/seed-persist (PERSIST_PATHS).
PERSIST_BINDS="etc/ssh etc/NetworkManager/system-connections var/lib/NetworkManager home"
# the root's copy of the FAT partition, and where FAT is mounted here.
FIRMWARE_DIR=boot/firmware
BOOTFS=/bootfs
BOOTFS_MOUNTED=
FIRMWARE_CHANGED=

find_dev() { blkid -L "$1" 2>/dev/null || findfs "LABEL=$1" 2>/dev/null || true; }

# overlayfs marks a directory that replaced a lower one (hiding its entries) with
# this xattr; plain tar/cp in the initramfs would drop it.
is_opaque() { busybox getfattr -n trusted.overlay.opaque "$1" 2>/dev/null | grep -q '="y"'; }

# fold_commit <staging> <data>: merge a staged overlay-upper tree into the
# committed one. entries move by rename (same filesystem), which keeps whiteouts,
# xattrs and file data intact and writes no file contents, so an interrupted fold
# loses nothing and resumes on the next boot. directories merge unless opaque.
fold_commit() {
	local s n d
	for s in "$1"/* "$1"/.*; do
		n="${s##*/}"
		case "$n" in .|..) continue ;; esac
		[ -e "$s" ] || [ -L "$s" ] || continue
		d="$2/$n"
		if [ -d "$s" ] && [ ! -L "$s" ] && [ -d "$d" ] && [ ! -L "$d" ] && ! is_opaque "$s"; then
			fold_commit "$s" "$d"
			chown "$(stat -c %u:%g "$s")" "$d"
			chmod "$(stat -c %a "$s")" "$d"
		else
			rm -rf "$d"
			mv "$s" "$d"
		fi
	done
}

# the firmware reads these at power-on; changing one needs a reboot to take
# effect. other files (e.g. the ssh.txt trigger raspios deletes on first boot)
# just sync.
needs_reboot() {
	case "$1" in
		*/kernel*|*/initramfs*|*.dtb|*.dtbo|*/overlays/*|*/config.txt|*/cmdline.txt|*.elf|*.dat|*/bootcode.bin) return 0 ;;
	esac
	return 1
}

# firmware_sync <list-root> <source-root>: for every path a writable layer
# (<list-root>) changed under boot/firmware, make FAT match <source-root>: copy
# files that differ, delete what the source lacks or whites out. sets
# FIRMWARE_CHANGED when a file the firmware loads was written. firmware names
# have no whitespace.
firmware_sync() {
	local p s d
	[ -d "$1/$FIRMWARE_DIR" ] && [ -n "$BOOTFS_MOUNTED" ] || return 0
	for p in $(cd "$1/$FIRMWARE_DIR" && find . -mindepth 1); do
		s="$2/$FIRMWARE_DIR/$p" d="$BOOTFS/$p"
		if [ -d "$s" ]; then
			mkdir -p "$d"
			continue
		elif [ -f "$s" ]; then
			cmp -s "$s" "$d" && continue
			cp "$s" "$d.new" && mv "$d.new" "$d" || continue
		elif [ -e "$d" ]; then
			rm -rf "$d" || continue
		else
			continue
		fi
		needs_reboot "$p" && FIRMWARE_CHANGED=1
	done
	sync
}

# the running kernel/initramfs predate what FAT now holds; restart into it.
reboot_if_firmware_changed() {
	[ -n "$FIRMWARE_CHANGED" ] || return 0
	echo "overlay: boot firmware synced; rebooting"
	umount "$BOOTFS"
	sync
	reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
	sleep 30
}

# overlay is a module the stock initramfs lacks. try the initramfs, then the base
# root, then the writable layer: after a committed kernel update the running
# kernel's modules exist only there.
load_overlay() {
	modprobe overlay 2>/dev/null && return 0
	modprobe -d /lower overlay 2>/dev/null && return 0
	[ -n "$1" ] && modprobe -d "$1/usr" overlay 2>/dev/null
}

# the assembled root keeps its own boot/firmware; bind it onto itself so the
# raspi-firmware kernel hooks, which insist on a mountpoint, write into it.
finish_root() {
	[ -n "$BOOTFS_MOUNTED" ] && umount "$BOOTFS"
	mkdir -p "${rootmnt}/$FIRMWARE_DIR"
	mount --bind "${rootmnt}/$FIRMWARE_DIR" "${rootmnt}/$FIRMWARE_DIR"
}

cmdline_value() { # cmdline_value <key>  -> value of key=... from /proc/cmdline
	for arg in $(cat /proc/cmdline); do
		case "$arg" in "$1"=*) echo "${arg#"$1"=}"; return ;; esac
	done
}

mount_bootfs() {
	boot_dev="$(find_dev "$BOOT_LABEL")"
	[ -n "$boot_dev" ] || return 0
	mkdir -p "$BOOTFS"
	mount -t vfat "$boot_dev" "$BOOTFS" 2>/dev/null && BOOTFS_MOUNTED=1
}

# restore the persist partition to its provisioned state. runs from the
# initramfs (nothing mounted from the overlay yet), so it can safely rewrite the
# writable layer of either shape. triggered by the RESET_FLAG on the boot fs.
factory_reset() {
	[ -n "$BOOTFS_MOUNTED" ] && [ -e "$BOOTFS/$RESET_FLAG" ] || return 0

	log_begin_msg "Factory reset requested; restoring persisted state"
	persist_dev="$(find_dev "$PERSIST_LABEL")"
	if [ -n "$persist_dev" ]; then
		mkdir -p /reset-persist
		mount -t ext4 "$persist_dev" /reset-persist
		# put back the base firmware for anything the discarded layer changed.
		firmware_sync "/reset-persist/$PERSIST_DATA" /lower
		# persistent shape: discard the writable upper (reverts to the
		# read-only lower image). ephemeral shape: reseed state from factory.
		rm -rf "/reset-persist/$PERSIST_DATA" "/reset-persist/$PERSIST_WORK"
		if [ -f "/reset-persist/$PERSIST_FACTORY" ]; then
			rm -rf "/reset-persist/$PERSIST_STATE"
			mkdir -p "/reset-persist/$PERSIST_STATE"
			tar -C "/reset-persist/$PERSIST_STATE" -xf "/reset-persist/$PERSIST_FACTORY"
		fi
		umount /reset-persist; rmdir /reset-persist
	fi
	rm -f "$BOOTFS/$RESET_FLAG"
	log_end_msg
}

local_mount_root()
{
	local_top
	local_device_setup "${ROOT}" "root file system"
	ROOT="${DEV}"

	if [ -z "${ROOTFSTYPE}" ] || [ "${ROOTFSTYPE}" = auto ]; then
		FSTYPE=$(get_fstype "${ROOT}")
	else
		FSTYPE=${ROOTFSTYPE}
	fi

	local_premount

	# lower: the real root, always read-only -- power loss cannot corrupt it.
	mkdir -p /lower
	# shellcheck disable=SC2086
	mount -r -t "${FSTYPE}" ${ROOTFLAGS} "${ROOT}" /lower

	mount_bootfs
	factory_reset
	reboot_if_firmware_changed

	persist_dev="$(find_dev "$PERSIST_LABEL")"
	upper_mode="$(cmdline_value overlay-upper)"
	[ -n "$upper_mode" ] || upper_mode=tmpfs

	# ---- persistent shape: the persist partition IS the writable upper ----
	if [ "$upper_mode" = persist ] && [ -n "$persist_dev" ]; then
		mkdir -p /upper
		mount -t ext4 "$persist_dev" /upper
		mkdir -p "/upper/$PERSIST_DATA" "/upper/$PERSIST_WORK"
		firmware_sync "/upper/$PERSIST_DATA" "/upper/$PERSIST_DATA"
		reboot_if_firmware_changed
		load_overlay "/upper/$PERSIST_DATA"
		mount -t overlay \
			-o "lowerdir=/lower,upperdir=/upper/$PERSIST_DATA,workdir=/upper/$PERSIST_WORK" \
			overlay "${rootmnt}"
		# expose persist so grow-persist can resize it online (the raw device is
		# busy under the live upper, so an offline resize cannot open it).
		mkdir -p "${rootmnt}/persist"
		mount --bind /upper "${rootmnt}/persist"
		finish_root
		return 0
	fi

	# ---- ephemeral (tmpfs) shape ----
	# changes live in a volatile RAM upper and vanish on reboot, UNLESS committed
	# with overlay-commit. committed changes live on persist as the UPPER of an
	# inner overlay over the base (so whiteouts apply and deletions persist); a
	# volatile tmpfs upper then stacks on top as the outer overlay:
	#   inner: base(/lower) + persist committed upper (PERSIST_DATA) -> /committed
	#   outer: /committed + tmpfs upper -> rootmnt
	# the disk is read-only in normal operation (all writes hit the tmpfs upper);
	# only a commit (the initramfs fold below) writes persist. power-safe.
	upper_mode=tmpfs
	outer_lower=/lower
	if [ -n "$persist_dev" ]; then
		mkdir -p /persist-disk
		mount -t ext4 "$persist_dev" /persist-disk
		# fold a staged commit into the committed upper before assembling; both
		# are overlay-upper trees on persist. the flag goes only once the fold is
		# on disk, so a power cut mid-fold resumes it on the next boot.
		if [ -f "/persist-disk/.commit-pending" ]; then
			log_begin_msg "overlay-commit: folding staged changes into persist"
			mkdir -p "/persist-disk/$PERSIST_DATA" "/persist-disk/staging/$PERSIST_DATA"
			fold_commit "/persist-disk/staging/$PERSIST_DATA" "/persist-disk/$PERSIST_DATA"
			sync
			rm -rf "/persist-disk/staging" "/persist-disk/.commit-pending"
			sync
			log_end_msg
		fi
		mkdir -p "/persist-disk/$PERSIST_DATA" "/persist-disk/$PERSIST_WORK" /committed
		firmware_sync "/persist-disk/$PERSIST_DATA" "/persist-disk/$PERSIST_DATA"
		reboot_if_firmware_changed
		load_overlay "/persist-disk/$PERSIST_DATA"
		# inner overlay: committed changes (incl. deletions) over the base.
		mount -t overlay \
			-o "lowerdir=/lower,upperdir=/persist-disk/$PERSIST_DATA,workdir=/persist-disk/$PERSIST_WORK" \
			overlay-committed /committed
		outer_lower=/committed
	fi

	load_overlay
	mkdir -p /upper
	mount -t tmpfs -o mode=0755 tmpfs /upper
	mkdir -p "/upper/$PERSIST_DATA" "/upper/$PERSIST_WORK"
	mount -t overlay \
		-o "lowerdir=$outer_lower,upperdir=/upper/$PERSIST_DATA,workdir=/upper/$PERSIST_WORK" \
		overlay "${rootmnt}"
	finish_root

	[ -n "$persist_dev" ] || return 0

	# expose persist (committed layer, staging, grow target) and the live tmpfs
	# upper in the booted root so overlay-commit can stage and grow-persist resize.
	mkdir -p "${rootmnt}/persist"
	mount --bind /persist-disk "${rootmnt}/persist"
	mkdir -p "${rootmnt}/persist/live-upper"
	mount --bind /upper "${rootmnt}/persist/live-upper"

	# re-attach persisted identity over the volatile upper so ssh host keys,
	# machine-id, NM connections and /home survive reboots without a commit.
	for p in $PERSIST_BINDS; do
		src="${rootmnt}/persist/$PERSIST_STATE/$p"
		[ -d "$src" ] || continue
		mkdir -p "${rootmnt}/$p"
		mount --bind "$src" "${rootmnt}/$p"
	done
	mid="${rootmnt}/persist/$PERSIST_STATE/etc/machine-id"
	[ -f "$mid" ] && mount --bind "$mid" "${rootmnt}/etc/machine-id"
}
